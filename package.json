{
  "name": "recipeapplication",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "test": "jest --ci"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@reduxjs/toolkit": "^2.13.0",
    "expo": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.88.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-responsive-screen": "^1.4.2",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "^0.13.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@react-native-async-storage/.*|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-responsive-screen|react-redux|@reduxjs/toolkit|immer))"
    ],
    "resolver": "react-native-reanimated/jest/resolver"
  }
}
